# Reference values only; services load their own environment files.
# Never put private credentials in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=false

HOST=127.0.0.1
PORT=5000
ML_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:3000
ML_TIMEOUT_MS=20000
ML_MODEL_DIR=

# Express application data / backend-only Firebase Admin configuration.
MONGODB_URI=
MONGODB_DB_NAME=medixai
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or configure Application Default Credentials using a protected file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-admin.json

# Optional local-only Auth emulator settings.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Optional integration/browser test configuration. Keep test credentials out of
# source control and use only a dedicated account and disposable database.
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# E2E_BROWSER_CHANNEL=msedge
# E2E_BASE_URL=http://localhost:3000
# MEDIXAI_GATEWAY_URL=http://127.0.0.1:5000
# MEDIXAI_ML_URL=http://127.0.0.1:8000
